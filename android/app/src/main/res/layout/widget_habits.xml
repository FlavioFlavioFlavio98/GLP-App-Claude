<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💪 Abitudini"
            android:textColor="#FFCA28"
            android:textSize="12sp"
            android:textStyle="bold"/>
        <TextView
            android:id="@+id/habits_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#888888"
            android:textSize="10sp"/>
        <TextView
            android:id="@+id/habits_refresh"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:text="↻"
            android:textColor="#666666"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <!-- Riga 0 -->
    <LinearLayout android:id="@+id/habit_row_0"
        android:layout_width="match_parent" android:layout_height="40dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="#1A1A1A" android:layout_marginBottom="3dp"
        android:padding="4dp" android:visibility="gone">
        <TextView android:id="@+id/habit_name_0"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="#FFFFFF"
            android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/habit_done_0"
            android:layout_width="36dp" android:layout_height="36dp"
            android:text="✓" android:textColor="#4CAF50" android:textSize="18sp"
            android:gravity="center" android:layout_marginStart="4dp"/>
        <TextView android:id="@+id/habit_fail_0"
            android:layout_width="36dp" android:layout_height="36dp"
            android:text="✗" android:textColor="#EF5350" android:textSize="18sp"
            android:gravity="center" android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Riga 1 -->
    <LinearLayout android:id="@+id/habit_row_1"
        android:layout_width="match_parent" android:layout_height="40dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="#1A1A1A" android:layout_marginBottom="3dp"
        android:padding="4dp" android:visibility="gone">
        <TextView android:id="@+id/habit_name_1"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="#FFFFFF"
            android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/habit_done_1"
            android:layout_width="36dp" android:layout_height="36dp"
            android:text="✓" android:textColor="#4CAF50" android:textSize="18sp"
            android:gravity="center" android:layout_marginStart="4dp"/>
        <TextView android:id="@+id/habit_fail_1"
            android:layout_width="36dp" android:layout_height="36dp"
            android:text="✗" android:textColor="#EF5350" android:textSize="18sp"
            android:gravity="center" android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Riga 2 -->
    <LinearLayout android:id="@+id/habit_row_2"
        android:layout_width="match_parent" android:layout_height="40dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="#1A1A1A" android:layout_marginBottom="3dp"
        android:padding="4dp" android:visibility="gone">
        <TextView android:id="@+id/habit_name_2"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="#FFFFFF"
            android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/habit_done_2"
            android:layout_width="36dp" android:layout_height="36dp"
            android:text="✓" android:textColor="#4CAF50" android:textSize="18sp"
            android:gravity="center" android:layout_marginStart="4dp"/>
        <TextView android:id="@+id/habit_fail_2"
            android:layout_width="36dp" android:layout_height="36dp"
            android:text="✗" android:textColor="#EF5350" android:textSize="18sp"
            android:gravity="center" android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Riga 3 -->
    <LinearLayout android:id="@+id/habit_row_3"
        android:layout_width="match_parent" android:layout_height="40dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="#1A1A1A" android:layout_marginBottom="3dp"
        android:padding="4dp" android:visibility="gone">
        <TextView android:id="@+id/habit_name_3"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="#FFFFFF"
            android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/habit_done_3"
            android:layout_width="36dp" android:layout_height="36dp"
            android:text="✓" android:textColor="#4CAF50" android:textSize="18sp"
            android:gravity="center" android:layout_marginStart="4dp"/>
        <TextView android:id="@+id/habit_fail_3"
            android:layout_width="36dp" android:layout_height="36dp"
            android:text="✗" android:textColor="#EF5350" android:textSize="18sp"
            android:gravity="center" android:layout_marginStart="8dp"/>
    </LinearLayout>

    <!-- Riga 4 -->
    <LinearLayout android:id="@+id/habit_row_4"
        android:layout_width="match_parent" android:layout_height="40dp"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="#1A1A1A" android:layout_marginBottom="3dp"
        android:padding="4dp" android:visibility="gone">
        <TextView android:id="@+id/habit_name_4"
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textColor="#FFFFFF"
            android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
        <TextView android:id="@+id/habit_done_4"
            android:layout_width="36dp" android:layout_height="36dp"
            android:text="✓" android:textColor="#4CAF50" android:textSize="18sp"
            android:gravity="center" android:layout_marginStart="4dp"/>
        <TextView android:id="@+id/habit_fail_4"
            android:layout_width="36dp" android:layout_height="36dp"
            android:text="✗" android:textColor="#EF5350" android:textSize="18sp"
            android:gravity="center" android:layout_marginStart="8dp"/>
    </LinearLayout>

    <TextView android:id="@+id/habits_empty"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="🎉 Tutto fatto!"
        android:textColor="#888888" android:textSize="12sp"
        android:gravity="center" android:padding="16dp"
        android:visibility="gone"/>

    <TextView android:id="@+id/habits_updated"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#444444" android:textSize="9sp"
        android:layout_marginTop="4dp"/>
</LinearLayout>
