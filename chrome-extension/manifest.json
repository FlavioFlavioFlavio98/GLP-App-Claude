{
  "manifest_version": 3,
  "name": "GLP — Task rapida",
  "version": "1.0",
  "description": "Aggiungi una task a GLP con una scorciatoia da tastiera, da qualunque sito.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Aggiungi task GLP (Ctrl+Shift+Y)"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y", "mac": "Command+Shift+Y" },
      "description": "Apri aggiunta rapida task GLP"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
