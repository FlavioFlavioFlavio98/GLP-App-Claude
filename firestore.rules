rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo Flavio può accedere
    function isAllowedUser() {
      return request.auth != null &&
             request.auth.token.email == 'flavio.rossi94@gmail.com';
    }

    // Documenti utente
    match /users/{userId} {
      allow read, write: if isAllowedUser();

      // Sottocollezione settings: stesse regole del documento padre
      match /settings/{doc} {
        allow read, write: if isAllowedUser();
      }

      // FCM tokens
      match /fcmTokens/{tokenId} {
        allow read, write: if isAllowedUser();
      }

      // Dati privati (es. peso)
      match /private/{doc} {
        allow read, write: if isAllowedUser();
      }

      // Letture (PDF personali)
      match /readings/{readingId} {
        allow read, write: if isAllowedUser();

        // Log singole letture completate
        match /logs/{logId} {
          allow read, write: if isAllowedUser();
        }
      }

      // Foto Progressi (check fisico periodico)
      match /bodyPhotos/{photoId} {
        allow read, write: if isAllowedUser();
      }
    }

    // Config (ex PIN) — non più usata, blocca tutto
    match /config/{document=**} {
      allow read, write: if false;
    }
  }
}
