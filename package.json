{
  "name": "glp-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/stamp-sw.js",
    "build:web": "vite build --base=/GLP-App-Claude/ && node scripts/stamp-sw.js",
    "build:android": "vite build --base=/ && node scripts/stamp-sw.js",
    "preview": "vite preview",
    "predeploy": "npm run build:board && npm run build:web",
    "deploy": "gh-pages -d dist",
    "cap:sync": "powershell -ExecutionPolicy Bypass -File fix-android.ps1",
    "emulators": "firebase emulators:start --only auth,firestore,storage --import=./.emulator-data --export-on-exit",
    "seed:emulator": "node scripts/seed-emulator.mjs",
    "dev:emulator": "vite --mode emulator",
    "build:extension": "esbuild chrome-extension/src/popup.js --bundle --outfile=chrome-extension/popup.bundle.js --format=iife --platform=browser",
    "build:board": "esbuild task-board/src/main.js --bundle --outfile=public/task-board/board.bundle.js --format=iife --platform=browser"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.3.0",
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "canvas-confetti": "^1.9.3",
    "chart.js": "^4.4.4",
    "firebase": "^12.17.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "gh-pages": "^6.2.0",
    "typescript": "^6.0.3",
    "vite": "^5.4.8"
  }
}
